HF_API_KEY=your_huggingface_api_key

HF_STT_MODEL=openai/whisper-large-v3-turbo
HF_STT_FALLBACK_MODEL=openai/whisper-large-v3
HF_ANALYSIS_MODEL=j-hartmann/emotion-english-distilroberta-base
HF_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
HF_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
HF_SENTIMENT_FALLBACK_MODEL=distilbert/distilbert-base-uncased-finetuned-sst-2-english

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# CogniVara Python Backend auth
AUTH_TOKEN_TTL_DAYS=30

# Google Sign-In (public Client ID, verified server-side against Google's own keys)
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Email verification (Resend - resend.dev sandbox address works with no domain setup)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_HOURS=24

# Error tracking (Sentry - both services read SENTRY_DSN; leave unset to disable)
SENTRY_DSN=your_sentry_dsn
ENVIRONMENT=development

# Raw audio storage (S3-compatible; leave unset to use local disk - fine for dev, but local
# files do NOT survive a redeploy on hosts with an ephemeral filesystem like Render's free
# tier). Works with real AWS S3, Cloudflare R2, Backblaze B2, MinIO, etc.
S3_BUCKET=your_bucket_name
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_REGION=us-east-1

PORT=3000
